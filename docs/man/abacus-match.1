.SH NAME
abacus-match - Match a Gherkin step to an Action


.SH SYNOPSIS
\fBabacus match [step-text] [flags]\fP


.SH DESCRIPTION
Match a Gherkin step to an existing action using tiered resolution: exact match via cucumber expressions, fuzzy match by text similarity, or suggest a new action.

.PP
Use --file to match all steps in a feature file at once. Use --create to
automatically create actions from suggestions.


.SH OPTIONS
\fB--create\fP[=false]
	Auto-create Action from suggestion

.PP
\fB-f\fP, \fB--file\fP=""
	Feature file to match all steps

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for match

.PP
\fB-k\fP, \fB--keyword\fP=""
	Step keyword (Given/When/Then)

.PP
\fB--threshold\fP=0
	Fuzzy match threshold


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--db\fP=".abacus/abacus.db"
	Path to the database file

.PP
\fB--json\fP[=false]
	Output in JSON format

.PP
\fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--verbose\fP[=false]
	Enable verbose output


.SH EXAMPLE
.EX
  $ abacus match "the user creates an account"
  $ abacus match --file features/login.feature
  $ abacus match "the admin deletes a user" --create
  $ abacus match --file features/login.feature --create --json
.EE


.SH SEE ALSO
\fBabacus(1)\fP


