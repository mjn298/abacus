.SH NAME
abacus-actions-create - Create a new action node


.SH SYNOPSIS
\fBabacus actions create  [flags]\fP


.SH DESCRIPTION
Create a new action node with optional Gherkin cucumber expression patterns and graph references.

.PP
Actions bridge Gherkin steps to implementation by linking routes, entities, and
pages. Gherkin patterns use cucumber expression syntax for step matching.


.SH OPTIONS
\fB--entity-ref\fP=[]
	Entity node IDs to link

.PP
\fB--gherkin\fP=[]
	Gherkin cucumber expression patterns

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--label\fP=""
	Human-readable label

.PP
\fB--page-ref\fP=[]
	Page node IDs to link

.PP
\fB--route-ref\fP=[]
	Route node IDs to link


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--db\fP=".abacus/abacus.db"
	Path to the database file

.PP
\fB--json\fP[=false]
	Output in JSON format

.PP
\fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--verbose\fP[=false]
	Enable verbose output


.SH EXAMPLE
.EX
  $ abacus actions create "create-user" --label "Create a new user"
  $ abacus actions create "login" --gherkin "the user logs in" --route-ref "route:POST-/auth/login"
  $ abacus actions create "view-profile" --route-ref "route:GET-/api/users/{id}" --entity-ref "entity:User" --page-ref "page:/profile"
.EE


