.SH NAME
abacus-graph - Show the connected subgraph around a node


.SH SYNOPSIS
\fBabacus graph  [flags]\fP


.SH DESCRIPTION
Perform a bidirectional BFS traversal from a node and display the connected subgraph.

.PP
Returns all nodes and edges reachable within the specified depth. Use --depth to
control how far the traversal extends from the starting node.


.SH OPTIONS
\fB-d\fP, \fB--depth\fP=2
	Maximum traversal depth

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for graph


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--db\fP=".abacus/abacus.db"
	Path to the database file

.PP
\fB--json\fP[=false]
	Output in JSON format

.PP
\fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--verbose\fP[=false]
	Enable verbose output


.SH EXAMPLE
.EX
  $ abacus graph "route:GET-/api/users"
  $ abacus graph "entity:User" --depth 3
  $ abacus graph "action:create-user" --depth 1 --json
.EE


