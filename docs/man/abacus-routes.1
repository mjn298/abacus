.SH NAME
abacus-routes - List or search route nodes


.SH SYNOPSIS
\fBabacus routes [flags]\fP


.SH DESCRIPTION
List all route nodes in the graph, optionally filtering by FTS5 search query.

.PP
Results include node ID, name, label, and source file. Use --json for
machine-readable output.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for routes

.PP
\fB-l\fP, \fB--limit\fP=0
	Maximum number of results (0 = all)

.PP
\fB-m\fP, \fB--match\fP=""
	FTS5 search query


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--db\fP=".abacus/abacus.db"
	Path to the database file

.PP
\fB--json\fP[=false]
	Output in JSON format

.PP
\fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--verbose\fP[=false]
	Enable verbose output


.SH EXAMPLE
.EX
