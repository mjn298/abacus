.SH NAME
abacus - Living application graph for Gherkin-driven BDD


.SH SYNOPSIS
\fBabacus [flags]\fP


.SH DESCRIPTION
Abacus models your application's API surface, entities, pages, and user actions. It bridges Gherkin specs to implementation through a persistent, cumulative graph.


.SH OPTIONS
\fB--db\fP=".abacus/abacus.db"
	Path to the database file

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for abacus

.PP
\fB--json\fP[=false]
	Output in JSON format

.PP
\fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--verbose\fP[=false]
	Enable verbose output


.SH EXAMPLE
.EX
  $ abacus init
  $ abacus scan
  $ abacus routes --match users
  $ abacus match "the user creates an account"
.EE


