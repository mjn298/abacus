.SH NAME
abacus-init - Initialize Abacus for the current project


.SH SYNOPSIS
\fBabacus init [flags]\fP


.SH DESCRIPTION
Creates the .abacus/ directory, generates a config file with auto-detected project settings, and initializes the SQLite database.

.PP
Project type and scanners are detected automatically from package.json, go.mod,
and other project files. Use --force to re-run detection on an existing project.


.SH OPTIONS
\fB--dir\fP="."
	Project directory to initialize

.PP
\fB--force\fP[=false]
	Re-detect scanners and overwrite config

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for init


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--db\fP=".abacus/abacus.db"
	Path to the database file

.PP
\fB--json\fP[=false]
	Output in JSON format

.PP
\fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--verbose\fP[=false]
	Enable verbose output


.SH EXAMPLE
.EX
  $ abacus init
  $ abacus init --dir ./my-project
  $ abacus init --force
.EE


.SH SEE ALSO
\fBabacus(1)\fP


